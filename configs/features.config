# ============================================================
# 功能全开的配置片段（arm64 / mainline 7.3.x）
# CI 用 scripts/kconfig/merge_config.sh 合并到 defconfig 之上，
# 再由 olddefconfig 解析依赖；不存在的符号会被忽略。
# ============================================================

# ---- 命名空间 / cgroup（容器、systemd、Droidspace 一类都要）----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
