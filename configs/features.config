CONFIG_MAC80211=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_QCA=y
CONFIG_RFKILL=y

# ---- 电源 / 温控 / 充电 ----
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_QCOM_FG=y
CONFIG_CHARGER_QCOM_SMB2=y
CONFIG_CHARGER_QCOM_SMB5=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# ---- 启动方式：必须关 EFI ----
# LG V50 的 LK 是老式 bootloader，直接跳到 Image 开头执行。
# 开着 CONFIG_EFI 时 Image 以 PE/COFF 头（"MZ@"）开头，LK 执行到的是数据
# 而不是指令 → 立刻崩 → ABL 判定启动失败 → 掉回 fastboot（实测 2026-11-23）。
# 关掉后 code0 恢复成 "b primary_entry"，与原厂 4.14 内核一致。
# CONFIG_EFI is not set

# ---- 虚拟化 / 其它增强 ----
CONFIG_KVM=y
CONFIG_VIRTUALIZATION=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VHOST_NET=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_SCHED_MC=y
CONFIG_ENERGY_MODEL=y

# ---- 调试 / 可靠性 ----
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_DEBUG_INFO_NONE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
